{
  "name": "@local/dsh-side-chat",
  "version": "2.2.0",
  "private": true,
  "description": "Private DSH side questions with inherited model context and no session-list entries.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.bundle.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client.bundle.js",
    "markdown.js",
    "build-client.mjs",
    "THIRD_PARTY_NOTICES.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node build-client.mjs",
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "marked": "18.2.0"
  }
}
