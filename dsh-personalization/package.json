{
  "name": "@local/dsh-personalization",
  "version": "1.0.0",
  "private": true,
  "description": "Profile-wide personal instructions for new and existing DSH conversations.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "core.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "scripts": {"test": "node --test test/*.test.js"},
  "dependencies": {"@deepseek-ai/schemastery": "~3.18.5"},
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-settings-general"]
    }
  }
}
