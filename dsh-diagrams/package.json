{
  "name": "@local/dsh-diagrams",
  "version": "1.0.0",
  "private": true,
  "description": "Readable, theme-aware Mermaid diagrams in DSH chat with source access and zoom controls.",
  "type": "module",
  "engines": {
    "dsh": "0.2.2-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.bundle.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "renderer.js",
    "diagram.js",
    "styles.js",
    "client.bundle.js",
    "build-client.mjs",
    "THIRD_PARTY_NOTICES.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node build-client.mjs",
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "devDependencies": {
    "dompurify": "3.4.18",
    "esbuild": "0.28.2",
    "mermaid": "12.3.0"
  }
}
