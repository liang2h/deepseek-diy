{
  "name": "@local/dsh-git-prompts",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "On-demand Git commit and pull-request instructions in DSH Settings",
  "license": "MIT",
  "engines": {"dsh": ">=0.2.2-rc.3 <0.3.0", "node": ">=24"},
  "exports": {".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg"},
  "files": ["index.js", "core.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "scripts": {"test": "node --test test/*.test.js", "check": "node --check index.js && node --check core.js && node --check client.js"},
  "dependencies": {"@deepseek-ai/schemastery": "~3.19.0", "zod": "^4.6.6"},
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {"platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-settings-general"]}
  }
}
